{
  "name": "woowangthon-team-11",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "node --experimental-strip-types --no-warnings --test \"packages/core/test/*.test.ts\"",
    "typecheck": "tsc -p packages/core && tsc -p apps/web --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
